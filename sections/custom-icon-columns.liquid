<style>
  .icon-columns {
    position: relative;
  }

  .icon-columns__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
    justify-content: space-between;
  }

  .icon-columns__track::-webkit-scrollbar {
    display: none;
  }

  .icon-columns__item {
    flex: 1 0 calc((100% - 4rem) / 5);
    max-width: 100%;
    scroll-snap-align: center;
    border: 1px solid #E3F3FF;
    background: {{  section.settings.background_color_box }};
    border-radius: 12px;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media (max-width: 749px) {
    .icon-columns__item {
      flex: 1 0 60cqw;
    }
  }

  .icon-columns__icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: {{ section.settings.image_color_picker }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .icon-columns__icon img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .icon-columns__heading {
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    {% comment %} letter-spacing: 0.03em; {% endcomment %}
    margin: 0 0 0.35rem;
  }

  .icon-columns__text {
    font-size: 13px;
    color: #5C554C;
    margin: 0;
    line-height: 1.4;
  }
</style>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="" style="{% render 'spacing-padding', settings: section.settings %}">
    <div class="icon-columns" id="icon-columns-{{ section.id }}" data-slider-mobile="true">
      <div class="icon-columns__track">
        {% for block in section.blocks %}
          {% if block.type == 'item' %}
            <div class="icon-columns__item" {{ block.shopify_attributes }}>
              {% if block.settings.icon %}
                <div class="icon-columns__icon">
                  <img
                    src="{{ block.settings.icon | image_url: width: 80 }}"
                    alt="{{ block.settings.heading | escape }}"
                    width="32"
                    height="32"
                    loading="lazy"
                  >
                </div>
              {% endif %}

              {% if block.settings.heading != blank %}
                <h3 class="icon-columns__heading">{{ block.settings.heading }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="icon-columns__text">{{ block.settings.text }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icon columns",
  "tag": "section",
  "class": "shopify-section--icon-columns",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "background_color_box",
      "label": "Block Background Color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "image_color_picker",
      "label": "Image Color Picker",
      "default": "#eaf2ff"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Have a question" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Email or call us" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Icon columns",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
