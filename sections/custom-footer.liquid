{% comment %} 
    All 6 top-level columns are BLOCKS, added/reordered/removed from the customizer:
    - brand: logo, heading, text, email signup form, second badge/logo image
    - menu: heading + a real Shopify menu (add this block 3x for My Accounts / Shop & Services / Company)
    - info: heading + repeatable icon+text rows (phone, email, location, hours)
    - social: heading + per-platform links + optional badge image 
    Email signup uses Shopify's real newsletter customer form (tags customer as 
    "newsletter" in Shopify Admin → Customers), not a fake/decorative form. 
    Payment icons use Shopify's native shop.enabled_payment_types — this 
    reflects whatever payment methods are actually enabled in your store, 
    automatically, with no manual list to maintain.
{% endcomment %}

<style>
  .site-footer {
    background: {{ section.settings.background_color | default: '#1a1613' }};
    color: {{ section.settings.text_color | default: '#f2ede6' }};
  }

  .site-footer__inner {
    padding: 1.5rem 0;
    overflow: hidden;
    margin: 0 auto;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    {% comment %} margin-bottom: 2.5rem;
  {% endcomment %}
  }

  /* --- Brand / newsletter block --- */
  .site-footer__brand-logos {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .site-footer__brand-logos img {
    display: block;
  }

  .site-footer__logo img {
    max-height: 120px;
    width: auto;
  }

  .site-footer__badge img {
    max-height: 80px;
    width: auto;
  }

  .site-footer__brand-text {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 1rem;
  }

  .site-footer__signup-form {
    display: flex;
    max-width: 320px;
  }

  .site-footer__signup-input {
    flex: 1;
    min-width: 0;
    height: 42px;
    padding: 0 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
    color: inherit;
    font-size: 13px;
    border-radius: 4px 0 0 4px;
  }

  .site-footer__signup-input::placeholder {
    color: rgba(242, 237, 230, 0.6);
  }

  .site-footer__signup-submit {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border: none;
    background: #ffffff;
    color: #1a1613;
    border-radius: 0 4px 4px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .site-footer__signup-submit svg {
    width: 16px;
    height: 16px;
  }

  .site-footer__signup-success {
    font-size: 12px;
    margin-top: 0.5rem;
    color: #8fd19e;
  }

  /* --- Menu / Info / Social column headings --- */
  .site-footer__col-heading {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 1rem;
    color: {{ section.settings.heading_color | default: '#ffffff' }};
  }

  /* --- Menu block --- */
  .site-footer__menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .site-footer__menu-list a {
    color: #F7F1E4;
    text-decoration: none;
    font-size: 14px;
  }

  .site-footer__menu-list a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* --- Info block --- */
  .site-footer__info-row {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
    font-size: 13px;
    line-height: 1.5;
  }

  .site-footer__info-row svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .site-footer__info-row a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__info-row a:hover {
    text-decoration: underline;
  }

  /* --- Social block --- */
  .site-footer__social-icons {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .site-footer__social-icons a {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
  }

  .site-footer__social-icons svg {
    width: 24px;
    height: 24px;
  }

  .site-footer__badge-img img {
    display: block;
    max-width: 90px;
  }

  /* --- Bottom bar: copyright + payment icons --- */
  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    {% comment %} flex-wrap: wrap;
  {% endcomment %}
  gap: 1rem;
  padding-top: 1.5rem;
  }

  .site-footer__copyright {
    font-size: 12px;
    opacity: 0.7;
    margin: 0;
  }

  .site-footer__payment-icons {
    display: flex;
    gap: 0.5rem;
  }

  .site-footer__payment-icons svg {
    height: 22px;
    width: auto;
  }

  /* --- Mobile --- */
  @media screen and (max-width: 989px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem 1.25rem;
    }

    .site-footer__grid > [data-block-type="brand"] {
      grid-column: 1 / -1;
    }

    .site-footer__grid > [data-block-type="social"] {
      grid-column: 1 / -1;
    }

    .site-footer__bottom {
      justify-content: center;
      text-align: center;
    }

    .lg-display {
      display: none !important;
    }
    .md-display {
      display: block !important;
    }
  }

  @media screen and (min-width: 750px) and(max-width: 989px) {
    .site-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .md-display {
    display: none;
  }
  .lg-display {
    margin-bottom: 16px;
  }
  .lg-display {
    padding-top: 16px;
    display: flex;
  }
</style>

<footer class="site-footer">
  <div class="site-footer__inner section--page-width section">
    <div class="site-footer__grid">
      {% for block in section.blocks %}

        {% case block.type %}

          {% when 'brand' %}
            <div data-block-type="brand" {{ block.shopify_attributes }}>
              <div class="site-footer__brand-logos">
                {% if block.settings.logo %}
                  <span class="site-footer__logo">
                    <img src="{{ block.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}">
                  </span>
                {% endif %}
                {% if block.settings.badge_image %}
                  <span class="site-footer__badge md-display">
                    <img src="{{ block.settings.badge_image | image_url: width: 200 }}" alt="{{ block.settings.badge_alt | escape }}">
                  </span>
                {% endif %}
              </div>

              {% if block.settings.text != blank %}
                <p class="site-footer__brand-text">{{ block.settings.text }}</p>
              {% endif %}

              {% render 'email-signup-snippet'
                , block: block %}

              {% if block.settings.badge_image %}
                <span class="site-footer__badge lg-display">
                  <img src="{{ block.settings.badge_image | image_url: width: 200 }}" alt="{{ block.settings.badge_alt | escape }}">
                </span>
              {% endif %}
            </div>

          {% when 'menu' %}
            <div data-block-type="menu" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3 class="site-footer__col-heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.menu != blank %}
                <ul class="site-footer__menu-list">
                  {% for link in block.settings.menu.links %}
                    <li>
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>

          {% when 'info' %}
            <div data-block-type="info" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <p class="site-footer__col-heading">{{ block.settings.heading }}</p>
              {% endif %}

              {% if block.settings.phone != blank %}
                <div class="site-footer__info-row">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                  <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a>
                </div>
              {% endif %}

              {% if block.settings.email != blank %}
                <div class="site-footer__info-row">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"><path d="M4 4h16v16H4z" opacity="0" /><path d="M22 6l-10 7L2 6" /><rect
                      x="2"
                      y="4"
                      width="20"
                      height="16"
                      rx="2" /></svg>
                  <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                </div>
              {% endif %}

              {% if block.settings.address != blank %}
                <div class="site-footer__info-row">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle
                      cx="12"
                      cy="10"
                      r="3" /></svg>
                  <span>{{ block.settings.address | newline_to_br }}</span>
                </div>
              {% endif %}

              {% if block.settings.hours != blank %}
                <div class="site-footer__info-row">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"><circle
                      cx="12"
                      cy="12"
                      r="10" /><path d="M12 6v6l4 2" /></svg>
                  <span>{{ block.settings.hours | newline_to_br }}</span>
                </div>
              {% endif %}
            </div>

          {% when 'social' %}
            <div data-block-type="social" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <p class="site-footer__col-heading">{{ block.settings.heading }}</p>
              {% endif %}

              <div class="site-footer__social-icons">
                {% if block.settings.facebook_url != blank %}
                  <a
                    href="{{ block.settings.facebook_url }}"
                    aria-label="Facebook"
                    target="_blank"
                    rel="noopener">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.5 9.9v-7H8v-2.9h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6v1.9H16l-.4 2.9h-2.1v7A10 10 0 0 0 22 12z" /></svg>
                  </a>
                {% endif %}
                {% if block.settings.instagram_url != blank %}
                  <a
                    href="{{ block.settings.instagram_url }}"
                    aria-label="Instagram"
                    target="_blank"
                    rel="noopener">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"><rect
                        x="2"
                        y="2"
                        width="20"
                        height="20"
                        rx="5" /><circle
                        cx="12"
                        cy="12"
                        r="4" /><circle
                        cx="17.5"
                        cy="6.5"
                        r="1" /></svg>
                  </a>
                {% endif %}
                {% if block.settings.youtube_url != blank %}
                  <a
                    href="{{ block.settings.youtube_url }}"
                    aria-label="YouTube"
                    target="_blank"
                    rel="noopener">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"><path d="M22.5 6.2a2.8 2.8 0 0 0-2-2C18.9 3.8 12 3.8 12 3.8s-6.9 0-8.5.4a2.8 2.8 0 0 0-2 2A29 29 0 0 0 1 12a29 29 0 0 0 .5 5.8 2.8 2.8 0 0 0 2 2c1.6.4 8.5.4 8.5.4s6.9 0 8.5-.4a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-5.8 29 29 0 0 0-.5-5.8z" /><path d="M9.8 15.5l6-3.5-6-3.5z" /></svg>
                  </a>
                {% endif %}
                {% if block.settings.discord_url != blank %}
                  <a
                    href="{{ block.settings.discord_url }}"
                    aria-label="Discord"
                    target="_blank"
                    rel="noopener">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.3.5a17.5 17.5 0 0 1 4.3 1.5c-1.8-.9-3.7-1.5-5.7-1.7a13 13 0 0 0-3.4 0 17 17 0 0 0-5.7 1.7 17.5 17.5 0 0 1 4.3-1.5L8.6 3a19.7 19.7 0 0 0-4.9 1.4C1.4 8.5.8 12.5 1.1 16.5a19.9 19.9 0 0 0 6 3l1-1.6a12.9 12.9 0 0 1-1.9-.9l.5-.4c3.7 1.7 7.7 1.7 11.4 0l.5.4c-.6.4-1.2.6-1.9.9l1 1.6a19.8 19.8 0 0 0 6-3c.4-4.7-.8-8.6-3.4-12.1zM8.7 14.1c-1.1 0-2-1-2-2.2s.9-2.2 2-2.2 2 1 2 2.2-.9 2.2-2 2.2zm6.6 0c-1.1 0-2-1-2-2.2s.9-2.2 2-2.2 2 1 2 2.2-.9 2.2-2 2.2z" /></svg>
                  </a>
                {% endif %}
                {% if block.settings.tiktok_url != blank %}
                  <a
                    href="{{ block.settings.tiktok_url }}"
                    aria-label="TikTok"
                    target="_blank"
                    rel="noopener">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.8a4.6 4.6 0 0 1-3.8-4.2h-3.1v14.4a2.7 2.7 0 1 1-1.9-2.6V10a5.7 5.7 0 1 0 5 5.7V9.5a7.6 7.6 0 0 0 4.4 1.4V7.8a4.6 4.6 0 0 1-.6 0z" /></svg>
                  </a>
                {% endif %}
              </div>

              {% if block.settings.badge_image %}
                <div class="site-footer__badge-img">
                  <img src="{{ block.settings.badge_image | image_url: width: 200 }}" alt="{{ block.settings.badge_alt | escape }}">
                </div>
              {% endif %}
            </div>

        {% endcase %}
      {% endfor %}
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        {% if section.settings.copyright_text != blank %}
          {{ section.settings.copyright_text }}
        {% else %}
          © {{ 'now' | date: '%Y' }} {{ shop.name }}. Powered by Shopify.
        {% endif %}
      </p>

      {% if section.settings.show_payment_icons %}
        <div class="site-footer__payment-icons">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
  {
    "name": "Custom footer",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#1a1613"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#f2ede6"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Column heading color",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Bottom bar"
      }, {
        "type": "text",
        "id": "copyright_text",
        "label": "Copyright text (leave blank for automatic)",
        "info": "If left blank, shows \"© [current year] [store name]. Powered by Shopify.\" automatically"
      }, {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Show payment icons",
        "info": "Automatically reflects payment methods enabled in Settings → Payments",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "brand",
        "name": "Brand & newsletter",
        "settings": [
          {
            "type": "image_picker",
            "id": "logo",
            "label": "Logo"
          },
          {
            "type": "image_picker",
            "id": "badge_image",
            "label": "Second logo / badge image"
          },
          {
            "type": "text",
            "id": "badge_alt",
            "label": "Badge image alt text"
          },
          {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Get tournament nights, new drops & buylist updates in your inbox."
          }, {
            "type": "text",
            "id": "email_placeholder",
            "label": "Email input placeholder",
            "default": "Email address"
          }
        ]
      }, {
        "type": "menu",
        "name": "Menu column",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "My Accounts"
          }, {
            "type": "link_list",
            "id": "menu",
            "label": "Menu"
          }
        ]
      }, {
        "type": "info",
        "name": "Store info",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Store Information"
          },
          {
            "type": "text",
            "id": "phone",
            "label": "Phone number"
          },
          {
            "type": "text",
            "id": "email",
            "label": "Email address"
          },
          {
            "type": "textarea",
            "id": "address",
            "label": "Address",
            "info": "Use line breaks for multi-line address"
          }, {
            "type": "textarea",
            "id": "hours",
            "label": "Opening hours",
            "info": "Use line breaks for each day"
          }
        ]
      }, {
        "type": "social",
        "name": "Social & badge",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Follow Us"
          },
          {
            "type": "url",
            "id": "facebook_url",
            "label": "Facebook URL"
          },
          {
            "type": "url",
            "id": "instagram_url",
            "label": "Instagram URL"
          },
          {
            "type": "url",
            "id": "youtube_url",
            "label": "YouTube URL"
          }, {
            "type": "url",
            "id": "discord_url",
            "label": "Discord URL"
          }, {
            "type": "url",
            "id": "tiktok_url",
            "label": "TikTok URL"
          }, {
            "type": "image_picker",
            "id": "badge_image",
            "label": "Badge / trust image (optional)"
          }, {
            "type": "text",
            "id": "badge_alt",
            "label": "Badge image alt text"
          }
        ]
      }
    ],
    "max_blocks": 8,
    "enabled_on": {
      "groups": ["footer"]
    },
    "presets": [
      {
        "name": "Custom footer",
        "blocks": [
          {
            "type": "brand"
          },
          {
            "type": "menu",
            "settings": {
              "heading": "My Accounts"
            }
          },
          {
            "type": "menu",
            "settings": {
              "heading": "Shop & Services"
            }
          },
          {
            "type": "menu",
            "settings": {
              "heading": "Company"
            }
          }, {
            "type": "info",
            "settings": {
              "heading": "Store Information"
            }
          }, {
            "type": "social"
          }
        ]
      }
    ]
  }
{% endschema %}
