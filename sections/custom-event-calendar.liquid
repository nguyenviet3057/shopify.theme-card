{{ 'custom-event-calendar.css' | asset_url | stylesheet_tag }}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign event_entries = shop.metaobjects.upcoming_event.values
  assign calendar_year = 'now' | date: '%Y'
  assign calendar_month = 'now' | date: '%m' | plus: 0
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <gl-event-calendar class="gl-event-calendar">
    <script type="application/json" data-events-json>
      [
        {%- assign gl_cal_first = true -%}
        {%- for event in event_entries -%}
          {%- assign event_time = event.time.value | default: event.time -%}
          {%- assign event_year = event_time | date: '%Y' -%}
          {%- assign event_month = event_time | date: '%m' | plus: 0 -%}
          {%- if event_time != blank and event_year == calendar_year and event_month >= calendar_month -%}
            {%- assign event_title = event.title.value | default: event.title -%}
            {%- assign event_game = event.game.value | default: event.game -%}
            {%- assign event_bg = event.background_color.value | default: event.background_color -%}
            {%- assign event_fg = event.text_color.value | default: event.text_color -%}
            {%- assign event_image = event.image.value | default: event.image -%}
            {%- assign tag_list = event.tags.value | default: event.tags -%}
            {%- assign event_description = '' -%}
            {%- if event.description != blank -%}
              {%- capture event_description -%}
                {{ event.description | metafield_tag }}
              {%- endcapture -%}
            {%- endif -%}

            {%- unless gl_cal_first -%},{%- endunless -%}
            {%- assign gl_cal_first = false -%}
            {
              "id": {{ event.system.handle | default: event.system.id | json }},
              "title": {{ event_title | strip | json }},
              "game": {{ event_game | json }},
              "descriptionHtml": {{ event_description | strip | json }},
              "image": {% if event_image != blank %}{{ event_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
              "time": {{ event_time | date: '%Y-%m-%dT%H:%M:%S' | json }},
              "textColor": {{ event_fg | append: '' | json }},
              "backgroundColor": {{ event_bg | append: '' | json }},
              "tags": [
                {%- if tag_list != blank -%}
                  {%- for tag in tag_list -%}
                    {%- assign tag_title = tag.title.value | default: tag.title -%}
                    {%- assign tag_bg = tag.background_color.value | default: tag.background_color -%}
                    {%- assign tag_fg = tag.text_color.value | default: tag.text_color -%}
                    {
                      "title": {{ tag_title | json }},
                      "textColor": {{ tag_fg | append: '' | json }},
                      "backgroundColor": {{ tag_bg | append: '' | json }}
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                {%- endif -%}
              ]
            }
          {%- endif -%}
        {%- endfor -%}
      ]
    </script>

    <div class="gl-event-calendar__header">
      {% if section.settings.subtitle != blank %}
        <p class="gl-event-calendar__kicker">{{ section.settings.subtitle }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="gl-event-calendar__title">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="gl-event-calendar__controls">
      <div class="gl-event-calendar__nav">
        <button type="button" class="gl-event-calendar__nav-btn" data-dir="-1" aria-label="Previous month">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <span class="gl-event-calendar__month-label" data-month-label></span>
        <button type="button" class="gl-event-calendar__nav-btn" data-dir="1" aria-label="Next month">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
      <div class="gl-event-calendar__controls-right">
        <label class="gl-event-calendar__search-wrap">
          <span class="visually-hidden">Search events</span>
          <input type="search" class="gl-event-calendar__search" data-search placeholder="Search events" aria-label="Search events">
          <svg class="gl-event-calendar__search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </label>
        <select class="gl-event-calendar__game-select" data-game-select aria-label="Filter by game">
          <option value="">Select game</option>
        </select>
      </div>
    </div>

    <div class="gl-event-calendar__skeleton" data-skeleton aria-hidden="true">
      {%- for i in (1..5) -%}
        <div class="gl-event-calendar__skeleton-row">
          {%- for j in (1..7) -%}
            <div class="gl-event-calendar__skeleton-cell"></div>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="gl-event-calendar__grid-wrapper" data-grid-wrapper hidden>
      <div class="gl-event-calendar__day-headers">
        <div>Monday</div>
        <div>Tuesday</div>
        <div>Wednesday</div>
        <div>Thursday</div>
        <div>Friday</div>
        <div>Saturday</div>
        <div>Sunday</div>
      </div>
      <div class="gl-event-calendar__grid-body" data-grid-body></div>
    </div>

    <div class="gl-event-calendar__agenda" data-agenda hidden></div>
    <p class="gl-event-calendar__empty" data-empty hidden>{{ section.settings.empty_message }}</p>

    <div class="gl-event-calendar__drawer" data-drawer role="dialog" aria-modal="true" aria-hidden="true" aria-label="Event details" hidden>
      <div class="gl-event-calendar__drawer-header">
        <h3 data-drawer-title>Event Details</h3>
        <button type="button" class="gl-event-calendar__drawer-close" data-drawer-close aria-label="Close event details">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="gl-event-calendar__drawer-body" data-drawer-body></div>
    </div>
    <div class="gl-event-calendar__backdrop" data-backdrop hidden></div>
  </gl-event-calendar>
</div>

<script src="{{ 'custom-event-calendar.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Event calendar",
  "tag": "section",
  "class": "shopify-section--event-calendar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming Events"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Kicker",
      "default": "Never miss a draft"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "No events this month."
    },
    {
      "type": "paragraph",
      "content": "Events are pulled from the Upcoming Event metaobject. Chip colours use each event's tags when present, then the event's own colours."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Event calendar"
    }
  ]
}
{% endschema %}
