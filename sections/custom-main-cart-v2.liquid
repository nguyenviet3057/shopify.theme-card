{% comment %}
  Clone of custom-main-cart with the shipping-options theme block
  instead of the /cart/shipping_rates.json estimator.
{% endcomment %}

{% capture shipping_options %}
  {% content_for 'block', type: 'shipping-options', id: 'cart-shipping-options' %}
{% endcapture %}

<style>
  .cart-page {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
    align-items: start;
  }

  .cart-page__heading {
    grid-column: 1 / -1;
    font-size: 28px;
    font-weight: 800;
    margin: 0 0 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e5e5;
  }

  .cart-page__items {
    display: flex;
    flex-direction: column;
  }

  /* --- Empty cart state --- */
  .cart-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem 1rem;
  }

  .cart-empty__icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 1.25rem;
    color: #c9c9c9;
  }

  .cart-empty__heading {
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 0.5rem;
    color: #1D1A17;
  }

  .cart-empty__text {
    font-size: 14px;
    color: #6b6b6b;
    margin: 0 0 1.5rem;
  }

  .cart-empty__continue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #111111;
    color: #ffffff;
    text-decoration: none;
    padding: 0.85rem 1.75rem;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 4px;
  }
  .cart-empty__continue:hover { background: #000; }

  .cart-item {
    display: grid;
    grid-template-columns: 24px 90px 1fr auto auto;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid #f0f0f0;
  }

  .cart-item__remove {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cart-item__remove svg { width: 18px; height: 18px; }

  .cart-item__image img {
    display: block;
    width: 100%;
    border-radius: 4px;
    border: 1px solid #eee;
  }

  .cart-item__title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .cart-item__title {
    font-weight: 700;
    font-size: 15px;
    color: #1D1A17;
    text-decoration: none;
    font-family: 'Oswald';
  }

  .cart-item__variant {
    margin: 0 0 0.25rem;
    font-size: 13px;
    font-weight: 400;
    color: #1D1A17;
    opacity: 0.6;
    line-height: 1.3;
  }
  
  .cart-item__badge {
    font-size: 11px;
    font-weight: 700;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
  }
  .cart-item__badge--foil {
    background: #E6EDFB;
    color: #14181A;
    background: linear-gradient(90deg, #EAF4FC 50%, #C7E0F4 100%, #8FB8DC 100%);
    border: 1px solid #D6EDFE; }
  .cart-item__badge--preorder { background: #FCE6D6; color: #C25A1E; }

  .cart-item__subtitle {
    font-size: 13px;
    color: #6b6b6b;
    margin: 0 0 2px;
  }

  .cart-item__unit-price {
    font-size: 13px;
    color: #6b6b6b;
  }

  .cart-item__qty {
    display: flex;
    align-items: center;
    border: 1px solid #C0DFF6;
    background: #ffffff;
    border-radius: 4px;
    height: 40px;
    width: 180px;
    justify-content: space-evenly;
  }
  .cart-item__qty button {
    width: 32px;
    height: 100%;
    border: none;
    background: none;
    font-size: 18px;
    cursor: pointer;
  }
  .cart-item__qty input {
    width: 34px;
    border: none;
    text-align: center;
    font-size: 14px;
  }

  .cart-item__price {
    font-weight: 700;
    font-size: 15px;
    color: {{ section.settings.price_color | default: '#2F6FED' }};
    padding: 0.3rem 0.6rem;
    min-width: 76px;
    text-align: center;
  }

  /* --- Sidebar --- */
  .cart-sidebar {
    position: sticky;
    top: 1.5rem;
  }

  .cart-summary {
    background: {{ section.settings.subtotal_bg_color | default: '#a10a0a' }};
    color: #ffffff;
    border-radius: 6px 6px 0 0;
    padding: 1.25rem;
  }

  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    font-family: 'Oswald';
  }

  .cart-summary__checkout {
    display: block;
    width: 100%;
    background: #111111;
    color: #ffffff;
    border: none;
    padding: 0.9rem;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: 4px;
    cursor: pointer;
  }
  .cart-summary__checkout:hover { background: #000; }

  .cart-shipping {
    border: 1px solid #C0DFF6;
    border-top: none;
    border-radius: 0 0 6px 6px;
    padding: 1.25rem;
    background: #ffffff;
  }

  .cart-shipping__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    padding: 0;
    font-family: 'Oswald';
  }
  .cart-shipping__toggle svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }
  .cart-shipping.is-open .cart-shipping__toggle svg {
    transform: rotate(180deg);
  }

  .cart-shipping__body {
    display: none;
    margin-top: 1rem;
  }
  .cart-shipping.is-open .cart-shipping__body {
    display: block;
  }

  .cart-shipping__body .gl-ship-options {
    gap: 0.9rem;
  }

  .cart-shipping__body .gl-ship-option {
    padding: 0.75rem 0.85rem;
  }

  @media screen and (max-width: 768px) {
    .cart-page {
      grid-template-columns: 1fr;
    }

    .cart-item {
      grid-template-columns: 90px auto auto 1fr;
      grid-template-areas:
        "image  details details details"
        "image  qty     remove  price";
      row-gap: 0.6rem;
      column-gap: 0.6rem;
      align-items: center;
    }

    /* remove icon is no longer top-left, it's alongside qty/price */
    .cart-item__remove {
      grid-area: remove;
      justify-self: center;
    }

    .cart-item__image {
      grid-area: image;
      align-self: start;
    }

    .cart-item__details {
      grid-area: details;
    }

    .cart-item__qty {
      grid-area: qty;
    }

    .cart-item__price {
      grid-area: price;
      justify-self: end;
      min-width: 0;
      padding: 0;
    }
  }

   @media screen and (max-width: 420px) {
    
    .cart-item__qty {
      width: 80px;
    }
  }
</style>

<div
  class="section section--{{ section.settings.section_width }} spacing-style"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  {% form 'cart', cart, class: 'cart-page cart-page--v2' %}
    <h1 class="cart-page__heading">Your Cart ({{ cart.item_count }})</h1>

    {% if cart.item_count == 0 %}
      <div class="cart-empty">
        <svg class="cart-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <p class="cart-empty__heading">Your cart is empty</p>
        <p class="cart-empty__text">Looks like you haven't added anything yet.</p>
        <a href="{{ section.settings.continue_shopping_url | default: routes.all_products_collection_url }}" class="cart-empty__continue">
          Continue shopping
        </a>
      </div>
    {% else %}
      <div class="cart-page__items">
        {% for item in cart.items %}
          <div class="cart-item" data-cart-item data-key="{{ item.key }}">
            <button type="button" class="cart-item__remove" data-remove-item aria-label="Remove {{ item.product.title }}">
              <svg width="15" height="17" viewBox="0 0 15 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.09961 0.5V1.7002H13.9004V2.5H12.7002V14.9893C12.7002 15.3662 12.5749 15.666 12.3193 15.9199C12.0602 16.1772 11.7627 16.2997 11.4004 16.2998H3C2.63866 16.2998 2.34151 16.1774 2.08203 15.918C1.82255 15.6585 1.7002 15.3613 1.7002 15V2.5H0.5V1.7002H5.2998V0.5H9.09961ZM2.5 15.5H11.9004V2.5H2.5V15.5ZM9.09961 5.2998V12.7002H8.2998V5.2998H9.09961ZM6.09961 5.2998V12.7002H5.2998V5.2998H6.09961Z" fill="currentColor"/>
              </svg>
            </button>

            <a href="{{ item.url }}" class="cart-item__image">
              {% if item.image %}
                <img
                  src="{{ item.image | image_url: width: 200 }}"
                  alt="{{ item.product.title | escape }}"
                  width="90"
                  height="90"
                >
              {% endif %}
            </a>

            <div class="cart-item__details">
              <div class="cart-item__title-row">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {% if item.product.metafields.custom.variant != blank %}
                  <span class="cart-item__badge cart-item__badge--foil">
                    {{- item.product.metafields.custom.variant -}}
                  </span>
                {% endif %}
                {% if item.product.tags contains 'Pre-order' %}
                  <span class="cart-item__badge cart-item__badge--preorder">Pre-order</span>
                {% endif %}
              </div>

              {% unless item.variant.title == 'Default Title' %}
                <p class="cart-item__variant">Variant: {{ item.variant.title }}</p>
              {% endunless %}

              {% if item.product.metafields.custom.subtitle != blank %}
                <p class="cart-item__subtitle">{{ item.product.metafields.custom.subtitle }}</p>
              {% endif %}

              {% if item.product.tags contains 'Pre-order' and item.product.metafields.custom.release_date != blank %}
                <p class="cart-item__subtitle">Release Date: {{ item.product.metafields.custom.release_date }}</p>
              {% endif %}

              <p class="cart-item__unit-price">{{ item.original_price | money }}</p>
            </div>

            <div class="cart-item__qty">
              <button type="button" data-qty-minus>&minus;</button>
              <input type="number" value="{{ item.quantity }}" min="1" data-qty-input>
              <button type="button" data-qty-plus>+</button>
            </div>

            <div class="cart-item__price" data-line-price>{{ item.original_line_price | money }}</div>
          </div>
        {% endfor %}
      </div>

      <div class="cart-sidebar">
        <div class="cart-summary">
          <div class="cart-summary__row">
            <span>Subtotal</span>
            <span data-cart-subtotal>{{ cart.total_price | money }}</span>
          </div>
          <button type="submit" name="checkout" class="cart-summary__checkout">Checkout</button>
        </div>

        {%- if shipping_options != blank -%}
          <div class="cart-shipping" data-shipping-widget>
            <button type="button" class="cart-shipping__toggle" data-shipping-toggle>
              <span>View shipping options</span>
              <svg viewBox="0 0 12 8" fill="none">
                <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="2"/>
              </svg>
            </button>

            <div class="cart-shipping__body">
              {{ shipping_options }}
            </div>
          </div>
        {%- endif -%}
      </div>
    {% endif %}
  {% endform %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.querySelector('.cart-page--v2');
    if (!root) return;

    /* --- Quantity stepper + remove (real /cart/change.js AJAX) --- */
    function updateLineItem(key, quantity) {
      return fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: quantity }),
      }).then(function (res) {
        return res.json();
      });
    }

    function refreshSubtotal(cart) {
      var subtotalEl = document.querySelector('[data-cart-subtotal]');
      if (subtotalEl && Shopify && Shopify.formatMoney) {
        subtotalEl.textContent = Shopify.formatMoney(cart.total_price, '{{ shop.money_format }}');
      }
    }

    root.querySelectorAll('[data-cart-item]').forEach(function (row) {
      var key = row.dataset.key;
      var qtyInput = row.querySelector('[data-qty-input]');
      var minusBtn = row.querySelector('[data-qty-minus]');
      var plusBtn = row.querySelector('[data-qty-plus]');
      var removeBtn = row.querySelector('[data-remove-item]');
      var linePriceEl = row.querySelector('[data-line-price]');

      function applyQuantity(newQty) {
        if (newQty < 1) newQty = 1;
        qtyInput.value = newQty;
        updateLineItem(key, newQty).then(function (cart) {
          refreshSubtotal(cart);
          var updatedItem = cart.items.find(function (i) {
            return i.key === key;
          });
          if (updatedItem && linePriceEl && Shopify && Shopify.formatMoney) {
            linePriceEl.textContent = Shopify.formatMoney(updatedItem.original_line_price, '{{ shop.money_format }}');
          }
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { itemCount: cart.item_count } }));
        });
      }

      if (minusBtn) {
        minusBtn.addEventListener('click', function () {
          applyQuantity(parseInt(qtyInput.value, 10) - 1);
        });
      }
      if (plusBtn) {
        plusBtn.addEventListener('click', function () {
          applyQuantity(parseInt(qtyInput.value, 10) + 1);
        });
      }
      if (qtyInput) {
        qtyInput.addEventListener('change', function () {
          applyQuantity(parseInt(qtyInput.value, 10));
        });
      }
      if (removeBtn) {
        removeBtn.addEventListener('click', function () {
          updateLineItem(key, 0).then(function (cart) {
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { itemCount: cart.item_count } }));
            window.location.reload();
          });
        });
      }
    });

    var widget = root.querySelector('[data-shipping-widget]');
    if (widget) {
      var toggleBtn = widget.querySelector('[data-shipping-toggle]');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', function () {
          widget.classList.toggle('is-open');
        });
      }
    }

    document.addEventListener('shopify:block:select', function (event) {
      if (!event.target || !event.target.contains(root) || !widget) return;
      widget.classList.add('is-open');
    });
  });
</script>

{% schema %}
{
  "name": "Custom cart v2",
  "tag": "section",
  "class": "shopify-section--main-cart-v2",
  "settings": [
    {
      "type": "color",
      "id": "subtotal_bg_color",
      "label": "Subtotal box background",
      "default": "#a10a0a"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price / accent color",
      "default": "#2F6FED"
    },
    {
      "type": "url",
      "id": "continue_shopping_url",
      "label": "\"Continue shopping\" link",
      "info": "Leave blank to default to your main products/collection page"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Custom cart v2",
      "blocks": [
        {
          "type": "shipping-options",
          "id": "cart-shipping-options",
          "static": true,
          "blocks": [
            {
              "type": "_shipping-group",
              "settings": {
                "title": "Letters"
              },
              "blocks": [
                {
                  "type": "_shipping-option",
                  "settings": {
                    "title": "Regular Post",
                    "description": "Tracked envelope · 2–6 business days",
                    "price": "$6.00"
                  }
                },
                {
                  "type": "_shipping-option",
                  "settings": {
                    "title": "Registered Post",
                    "description": "Signature required on delivery · extra protection for your cards · 2–6 business days",
                    "price": "$8.00"
                  }
                },
                {
                  "type": "_shipping-option",
                  "settings": {
                    "title": "Express Post",
                    "description": "Next business day · fully tracked",
                    "price": "$10.00"
                  }
                }
              ]
            },
            {
              "type": "_shipping-group",
              "settings": {
                "title": "Parcels"
              },
              "blocks": [
                {
                  "type": "_shipping-option",
                  "settings": {
                    "title": "Standard Parcel",
                    "description": "Flat rate tracked shipping · 3–8 business days",
                    "price": "$10.00"
                  }
                },
                {
                  "type": "_shipping-option",
                  "settings": {
                    "title": "Registered Parcel",
                    "description": "Signature required on delivery · 3–8 business days",
                    "price": "$15.00"
                  }
                },
                {
                  "type": "_shipping-option",
                  "settings": {
                    "title": "Express Parcel",
                    "description": "Next business day · fully tracked",
                    "price": "$20.00"
                  }
                }
              ]
            },
            {
              "type": "_shipping-group",
              "settings": {
                "title": "Add-on — Shipping insurance"
              },
              "blocks": [
                {
                  "type": "_shipping-option",
                  "settings": {
                    "title": "Basic cover",
                    "description": "Covers your order up to $300",
                    "price": "+$5.00"
                  }
                },
                {
                  "type": "_shipping-option",
                  "settings": {
                    "title": "Standard cover",
                    "description": "Covers your order up to $500",
                    "price": "+$10.00"
                  }
                },
                {
                  "type": "_shipping-option",
                  "settings": {
                    "title": "Premium cover",
                    "description": "Covers your order up to $1000",
                    "price": "+$20.00"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
