<script
  src="{{ 'marquee.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign separator_type = section.settings.separator_type
  assign show_separator = false

  if separator_type == 'text' and section.settings.separator_text != blank
    assign show_separator = true
  elsif separator_type == 'icon' and section.settings.separator_icon != blank and section.settings.separator_icon != 'none'
    assign show_separator = true
  elsif separator_type == 'image' and section.settings.separator_image != blank
    assign show_separator = true
  elsif separator_type == 'html' and section.settings.separator_html != blank
    assign show_separator = true
  endif
%}

<aside
  class="header-announcement-v2 section section--{{ section.settings.section_width }}"
  style="
    --header-announcement-bg: {{ section.settings.background_color }};
    --header-announcement-color: {{ section.settings.text_color }};
    --marquee-gap: {{ section.settings.gap }};
    --marquee-direction: {{ section.settings.movement_direction }};
    --header-announcement-padding-block: {{ section.settings.padding_block }}px;
  "
>
  <marquee-component
    class="header-announcement-v2__marquee"
    data-speed-factor="{{ section.settings.speed }}"
    data-movement-direction="{{ section.settings.movement_direction }}"
  >
    <div
      class="header-announcement-v2__wrapper"
      ref="wrapper"
    >
      <div
        class="header-announcement-v2__content"
        ref="content"
      >
        <div
          class="header-announcement-v2__items"
          ref="marqueeItems[]"
        >
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </marquee-component>
  {% if show_separator %}
    <template id="HeaderAnnouncementSeparator-{{ section.id }}">
      <span class="header-announcement-v2__separator" aria-hidden="true">
        {% case separator_type %}
          {% when 'text' %}
            {{ section.settings.separator_text }}
          {% when 'icon' %}
            <svg
              class="header-announcement-v2__icon"
              aria-hidden="true"
              focusable="false"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
            >
              {% render 'icon', icon: section.settings.separator_icon %}
            </svg>
          {% when 'image' %}
            {{
              section.settings.separator_image
              | image_url: width: 80
              | image_tag: alt: '', widths: '40, 80', loading: 'lazy'
            }}
          {% when 'html' %}
            {{ section.settings.separator_html }}
        {% endcase %}
      </span>
    </template>
  {% endif %}
  <script>
    (function () {
      var sectionEl = document.currentScript.closest('.header-announcement-v2');
      var root = sectionEl && sectionEl.querySelector('.header-announcement-v2__items');
      if (!root) return;

      root.querySelectorAll("slideshow-slide[aria-hidden='true']").forEach(function (slide) {
        slide.setAttribute('aria-hidden', 'false');
      });

      var template = document.getElementById('HeaderAnnouncementSeparator-{{ section.id }}');
      if (!template) return;

      var children = Array.from(root.children);
      children.forEach(function (child, index) {
        if (index === 0) return;
        root.insertBefore(template.content.cloneNode(true), child);
      });
      if (children.length > 0) root.appendChild(template.content.cloneNode(true));
    })();
  </script>
</aside>

{% stylesheet %}
  .header-announcement-v2 {
    background: var(--header-announcement-bg, transparent);
    color: var(--header-announcement-color, inherit);
    padding-block: var(--header-announcement-padding-block, 0.5rem);
    --color-background: var(--header-announcement-bg, transparent);
  }

  .header-announcement-v2__marquee {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .header-announcement-v2__wrapper,
  .header-announcement-v2__content,
  .header-announcement-v2__items {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    width: max-content;
  }

  .header-announcement-v2__items > * {
    flex: 0 0 auto;
    width: max-content;
    max-width: none;
  }

  .header-announcement-v2__separator {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: inherit;
    white-space: nowrap;
  }

  .header-announcement-v2 slideshow-slide {
    --width: max-content;
    width: max-content;
    opacity: 1;
    visibility: visible;
    white-space: nowrap;
  }

  .header-announcement-v2__separator :is(p) {
    margin: 0;
  }

  .header-announcement-v2__link,
  .header-announcement-v2__text {
    color: inherit;
    text-decoration: none;
  }

  .header-announcement-v2__icon,
  .header-announcement-v2__separator img,
  .header-announcement-v2__separator svg {
    display: block;
    width: 1.25em;
    height: 1.25em;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: no-preference) {
    .header-announcement-v2__marquee:not([data-disabled]) .header-announcement-v2__wrapper {
      animation: header-announcement-v2-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }
  }

  @keyframes header-announcement-v2-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }
{% endstylesheet %}

