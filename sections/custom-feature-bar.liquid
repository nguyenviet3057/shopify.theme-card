<style>
.feature-bar {
  background: {{ section.settings.background_color | default: '#a10a0a' }};
}

.feature-bar__track {
  display: flex;
  gap: 2rem;
  padding: 1.5rem 0;
  justify-content: space-between;
  flex-wrap: wrap;
}

.feature-bar__item-main {
    display: flex;
    align-items: center;
    justify-content: flex-start;
}

.feature-bar__item {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  text-decoration: none;
  color: inherit;
  
}

.feature-bar__icon {
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-bar__icon img,
.feature-bar__icon svg {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.feature-bar__text {
  display: flex;
  flex-direction: column;
}

.feature-bar__heading {
  margin: 0;
  font-size: 28px;
  font-weight: 600;
  font-family: var(--font-h3--family) !important;
  color: {{ section.settings.heading_color | default: '#ffffff' }};
  line-height: 1.15;
}

.feature-bar__subheading {
  margin: 0.15rem 0 0;
  font-size: 14px;
  font-weight: 400;
  color: {{ section.settings.subheading_color | default: '#f1c9c9' }};
}

@media screen and (max-width: 749px) {
  {% comment %} .feature-bar__heading {
    font-size: 18px;
  } {% endcomment %}
  .feature-bar__item{
    min-width: 240px;
  }
  .feature-bar__track {
    gap: 12px;
    flex-direction: column;
    overflow: hidden;
  }
}
</style>

<div class="feature-bar">
  <div class="section section--{{ section.settings.section_width }}" style="{% render 'spacing-padding', settings: section.settings %}">
    <div class="feature-bar__track">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <div class="feature-bar__item-main">
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="feature-bar__item" {{ block.shopify_attributes }}>
          {% else %}
            <div class="feature-bar__item" {{ block.shopify_attributes }}>
          {% endif %}

            {% if block.settings.icon %}
              <span class="feature-bar__icon">
                <img
                  src="{{ block.settings.icon | image_url: width: 80 }}"
                  alt="{{ block.settings.heading | escape }}"
                  width="34"
                  height="34"
                  loading="lazy"
                >
              </span>
            {% endif %}

            <span class="feature-bar__text">
              {% if block.settings.heading != blank %}
                <span class="feature-bar__heading">{{ block.settings.heading }}</span>
              {% endif %}
              {% if block.settings.subheading != blank %}
                <span class="feature-bar__subheading">{{ block.settings.subheading }}</span>
              {% endif %}
            </span>

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature bar",
  "tag": "section",
  "class": "shopify-section--feature-bar",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#a10a0a"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#f1c9c9"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Australia's Premier" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "Magic Singles Site" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Feature bar",
      "blocks": [
        {
          "type": "item",
          "settings": { "heading": "Australia's Premier", "subheading": "Magic Singles Site" }
        },
        {
          "type": "item",
          "settings": { "heading": "Card Condition Guide", "subheading": "Card Condition Guide" }
        },
        {
          "type": "item",
          "settings": { "heading": "Returns & Exchanges", "subheading": "All you need to know" }
        },
        {
          "type": "item",
          "settings": { "heading": "Terms & Conditions", "subheading": "Magic Singles Site" }
        }
      ]
    }
  ]
}
{% endschema %}
