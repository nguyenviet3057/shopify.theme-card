<style>
  .hero-carousel {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .hero-carousel__track {
    display: flex;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .hero-carousel__slide {
    position: relative;
    flex: 0 0 100%;
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-carousel__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    border-radius: 8px;
  }

  .hero-carousel__content {
    position: relative;
    z-index: 1;
    max-width: 450px;
    padding: 2rem 2rem 4rem;
    color: #ffffff;
    text-align: center;
    background: #4A4A4A80;
  }

  .hero-carousel__content--left {
    margin-right: auto;
    text-align: left;
  }
  .hero-carousel__content--right {
    margin-left: auto;
    text-align: right;
  }

  .hero-carousel__subheading {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    color: #f7f1e4;
    {% comment %} margin: 0 0 1rem;
  {% endcomment %}
  {% comment %} text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
{% endcomment %}
}

.hero-carousel__heading {
  font-size: 44px;
  font-weight: 600;
  margin: 0;
  color: #f7f1e4;
  padding-bottom: 16px;
}

.hero-carousel__description {
  font-size: 14px;
  color: #f7f1e4;
  font-weight: 400;
  line-height: 24px;
  margin: 0 0 2rem;
  text-align: left;
}

.hero-carousel__buttons {
  display: flex;
  gap: 1.25rem;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.hero-carousel__content--left .hero-carousel__buttons {
  justify-content: flex-start;
}
.hero-carousel__content--right .hero-carousel__buttons {
  justify-content: flex-end;
}

.button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 16px 32px;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 14px;
  {% comment %} letter-spacing: 0.04em;
{% endcomment %}
border-radius: 8px;
text-decoration: none;
transition: background 0.2s ease
, color 0.2s ease
, gap 0.2s ease;
}

.button--primary {
  background: #1D1A17;
  color: #F7F1E4;
}

.button--secondary {
  background: transparent;
  color: #F7F1E4;
  padding-left: 0;
  padding-right: 0;
}

.button--secondary svg {
  transition: transform 0.2s ease;
}

.button--secondary:hover svg {
  transform: translateX(3px);
}

/* --- Individual progress bars --- */
.hero-carousel__dots {
  position: absolute;
  bottom: 60px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  z-index: 2;
}

.hero-carousel__dot {
  width: 64px;
  height: 4px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.35);
  border: none;
  cursor: pointer;
  padding: 0;
  overflow: hidden;
  position: relative;
}

.hero-carousel__dot-fill {
  display: block;
  height: 100%;
  width: 100%;
  background: #ffffff;
  border-radius: inherit;
  transform: scaleX(0);
  transform-origin: left center;
}

/* Active slide without autoplay: show filled */
.hero-carousel__dot.is-active:not(.is-progressing) .hero-carousel__dot-fill {
  transform: scaleX(1);
}

.hero-carousel__dot.is-progressing .hero-carousel__dot-fill {
  animation: hero-dot-progress var(--hero-progress-ms, 5000ms) linear forwards;
}

.hero-carousel__dot.is-paused .hero-carousel__dot-fill {
  animation-play-state: paused;
}

@keyframes hero-dot-progress {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

/* Tablet */
@media screen and (min-width: 750px) {
  .hero-carousel__slide {
    min-height: 420px;
  }
}

/* Desktop */
{% comment %} @media screen and (min-width: 990px) {
  .hero-carousel__slide {
    min-height: 480px;
  }
}
{% endcomment %}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .hero-carousel__track {
    transition: none;
  }
  .hero-carousel__dot-fill {
    animation: none !important;
  }

  .hero-carousel__dot.is-active .hero-carousel__dot-fill {
    transform: scaleX(1);
  }
}

/* --- Mobile: buttons move below the image, dots stay on the image --- */
.hero-carousel__buttons-mobile {
  display: none;
}

@media screen and (max-width: 750px) {
  .hero-carousel__slide {
    min-height: 320px;
  }

  .hero-carousel__content {
    padding: 1.25rem;
  }

  .hero-carousel__heading {
    /* font-size: 26px; */
    padding-bottom: 10px;
  }

  .hero-carousel__description {
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 0.5rem;
  }

  /* hide the inline buttons that sit on top of the image */
  .hero-carousel__content .hero-carousel__buttons {
    display: none;
  }

  .hero-carousel__dots {
    {% comment %} bottom: 16px;
  {% endcomment %}
}

/* show the separate buttons block below the image instead */
.hero-carousel__buttons-mobile {
  display: block;
  padding: 12px 0 0;
}

.mble-btn {
  color: #000000;
}

.hero-carousel__buttons-mobile-slide {
  display: none;
}

.hero-carousel__buttons-mobile-slide.is-active {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  align-items: center;
}
}
</style>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}" style="{% render 'spacing-padding', settings: section.settings %}">
  <div
    class="hero-carousel"
    id="hero-carousel-{{ section.id }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
    style="--hero-progress-ms: {{ section.settings.autoplay_speed | times: 1000 }}ms;">
    <div class="hero-carousel__track">
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <div class="hero-carousel__slide" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <img
                class="hero-carousel__image"
                src="{{ block.settings.image | image_url: width: 1600 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 800 }} 800w,
                  {{ block.settings.image | image_url: width: 1200 }} 1200w,
                  {{ block.settings.image | image_url: width: 1600 }} 1600w
                "
                sizes="100vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                loading="{% if forloop.index == 1 %}eager{% else %}lazy{% endif %}">
            {% else %}
              <div class="hero-carousel__image hero-carousel__image--placeholder">
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}

            <div class="hero-carousel__content hero-carousel__content--{{ block.settings.text_align }}">
              {% if block.settings.subheading != blank %}
                <p class="hero-carousel__subheading">{{ block.settings.subheading }}</p>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h2 class="hero-carousel__heading">{{ block.settings.heading }}</h2>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="hero-carousel__description">{{ block.settings.description }}</p>
              {% endif %}
              <div class="hero-carousel__buttons">
                {% if block.settings.button_label != blank %}
                  <a href="{{ block.settings.button_link | default: '#' }}" class="button button--primary">
                    {{- block.settings.button_label -}}
                  </a>
                {% endif %}
                {% if block.settings.button_label_2 != blank %}
                  <a href="{{ block.settings.button_link_2 | default: '#' }}" class="button button--secondary">
                    {{ block.settings.button_label_2 }}
                    <svg
                      viewBox="0 0 24 24"
                      width="16"
                      height="16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="hero-carousel__dots" role="tablist">
        {% for block in section.blocks %}
          <button
            type="button"
            class="hero-carousel__dot{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}">
            <span class="hero-carousel__dot-fill" aria-hidden="true"></span>
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="hero-carousel__buttons-mobile">
    {% for block in section.blocks %}
      {% if block.type == 'slide' %}
        <div class="hero-carousel__buttons-mobile-slide{% if forloop.first %} is-active{% endif %}" data-buttons-index="{{ forloop.index0 }}">
          {% if block.settings.button_label != blank %}
            <a href="{{ block.settings.button_link | default: '#' }}" class="button button--primary">
              {{- block.settings.button_label -}}
            </a>
          {% endif %}
          {% if block.settings.button_label_2 != blank %}
            <a href="{{ block.settings.button_link_2 | default: '#' }}" class="
                button mble-btn
                mble-btn button--secondary
              ">
              {{ block.settings.button_label_2 }}
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.getElementById('hero-carousel-{{ section.id }}');
    if (!root) return;
  
    var track = root.querySelector('.hero-carousel__track');
    var slides = root.querySelectorAll('.hero-carousel__slide');
    var dots = root.querySelectorAll('.hero-carousel__dot');
    var mobileButtonSlides = root.parentElement.querySelectorAll('.hero-carousel__buttons-mobile-slide');
    var total = slides.length;
    var current = 0;
    var autoplay = root.dataset.autoplay === 'true';
    var speed = parseInt(root.dataset.speed, 10) || 5000;
    var timer = null;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
    if (!total) return;
  
    function resetProgress(dot) {
      dot.classList.remove('is-progressing', 'is-paused');
      var fill = dot.querySelector('.hero-carousel__dot-fill');
      if (!fill) return;
      fill.style.animation = 'none';
      void fill.offsetWidth;
      fill.style.animation = '';
    }
  
    function startProgress(dot) {
      if (!autoplay || reduceMotion || total < 2) return;
      resetProgress(dot);
      dot.classList.add('is-progressing');
    }
  
    function pauseProgress() {
      dots.forEach(function (dot) {
        if (dot.classList.contains('is-progressing')) {
          dot.classList.add('is-paused');
        }
      });
    }
  
    function goTo(index) {
      current = (index + total) % total;
      track.style.transform = 'translateX(-' + current * 100 + '%)';
  
      dots.forEach(function (dot) {
        var isActive = parseInt(dot.dataset.index, 10) === current;
        resetProgress(dot);
        dot.classList.toggle('is-active', isActive);
        if (isActive) startProgress(dot);
      });
  
      mobileButtonSlides.forEach(function (slide) {
        slide.classList.toggle('is-active', parseInt(slide.dataset.buttonsIndex, 10) === current);
      });
    }
  
    function startAutoplay() {
      if (!autoplay || total < 2) return;
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
      var activeDot = root.querySelector('.hero-carousel__dot.is-active');
      if (activeDot) startProgress(activeDot);
      timer = setInterval(function () {
        goTo(current + 1);
      }, speed);
    }
  
    function stopAutoplay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
      pauseProgress();
    }
  
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        goTo(parseInt(dot.dataset.index, 10));
        startAutoplay();
      });
    });
  
    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
  
    goTo(0);
    startAutoplay();
  });
</script>

{% schema %}
  {
    "name": "Hero carousel",
    "tag": "section",
    "class": "shopify-section--hero-carousel",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "t:settings.background_color",
        "placeholder": "t:settings.default"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "t:settings.width",
        "options": [
          {
            "value": "page-width",
            "label": "t:options.page"
          }, {
            "value": "full-width",
            "label": "t:options.full"
          }
        ],
        "default": "page-width"
      },
      {
        "type": "header",
        "content": "t:content.padding"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }, {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }, {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay slides",
        "default": true
      }, {
        "type": "range",
        "id": "autoplay_speed",
        "label": "Autoplay speed (seconds)",
        "min": 3,
        "max": 10,
        "step": 1,
        "default": 5
      }
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "RIFTBOUND: ORIGINS"
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "Subheading",
            "default": "Pre-order now"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "The Runeterra you know, now in your hands. Build your legend with Champions like Ahri, Yasuo and Jinx in Riot Games' first-ever TCG."
          }, {
            "type": "select",
            "id": "text_align",
            "label": "Content position",
            "options": [
              {
                "value": "left",
                "label": "Left"
              }, {
                "value": "center",
                "label": "Center"
              }, {
                "value": "right",
                "label": "Right"
              }
            ],
            "default": "center"
          }, {
            "type": "text",
            "id": "button_label",
            "label": "First button label",
            "default": "Shop now"
          }, {
            "type": "url",
            "id": "button_link",
            "label": "First button link"
          }, {
            "type": "text",
            "id": "button_label_2",
            "label": "Second button label",
            "default": "View release event"
          }, {
            "type": "url",
            "id": "button_link_2",
            "label": "Second button link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Hero carousel",
        "blocks": [
          {
            "type": "slide"
          }, {
            "type": "slide"
          }, {
            "type": "slide"
          }
        ]
      }
    ]
  }
{% endschema %}
