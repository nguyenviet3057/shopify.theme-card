<style>
  .hero-carousel {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    display: grid;
    container-type: inline-size;
  }

  .hero-carousel__track {
    display: flex;
    grid-column: 1 / -1;
    grid-row: 1;
    width: 100%;
    min-width: 0;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  .hero-carousel__slide {
    flex: 0 0 100cqw;
    width: 100cqw;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'media'
      'content';
    align-items: stretch;
    gap: 16px 0;
    aspect-ratio: auto;
  }

  .hero-carousel__media {
    grid-area: media;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
  }

  .hero-carousel__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-carousel__image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e4dc;
  }

  .hero-carousel__image--placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-carousel__content {
    grid-area: content;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    max-width: 100%;
    padding: 0;
    color: #1d1a17;
    text-align: center;
    background: transparent;
    overflow-wrap: break-word;
  }

  .hero-carousel__content--left {
    text-align: left;
  }

  .hero-carousel__content--right {
    text-align: right;
  }

  .hero-carousel__subheading {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    color: #1d1a17;
    margin: 0 0 0.5rem;
  }

  .hero-carousel__heading {
    font-size: 28px;
    font-weight: 600;
    margin: 0;
    color: #1d1a17;
    padding-bottom: 10px;
  }

  .hero-carousel__description {
    font-size: 14px;
    color: #1d1a17;
    font-weight: 400;
    line-height: 24px;
    margin: 0 0 1.25rem;
  }

  .hero-carousel__content--center .hero-carousel__description {
    text-align: center;
  }

  .hero-carousel__content--left .hero-carousel__description {
    text-align: left;
  }

  .hero-carousel__content--right .hero-carousel__description {
    text-align: right;
  }

  .hero-carousel__buttons {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-carousel__content--left .hero-carousel__buttons {
    justify-content: flex-start;
  }

  .hero-carousel__content--right .hero-carousel__buttons {
    justify-content: flex-end;
  }

  .hero-carousel .button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 32px;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 14px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, gap 0.2s ease;
  }

  .hero-carousel .button--primary {
    background: #1d1a17;
    color: #f7f1e4;
  }

  .hero-carousel .button--secondary {
    background: transparent;
    color: #1d1a17;
    padding-left: 0;
    padding-right: 0;
  }

  .hero-carousel .button--secondary svg {
    transition: transform 0.2s ease;
  }

  .hero-carousel .button--secondary:hover svg {
    transform: translateX(3px);
  }

  .hero-carousel__dots {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    justify-self: center;
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 0;
    z-index: 2;
    transform: translateY(calc(100cqw * 10 / 16 - 16px - 100%));
  }

  .hero-carousel__dot {
    width: 64px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.35);
    border: none;
    cursor: pointer;
    padding: 0;
    overflow: hidden;
    position: relative;
  }

  .hero-carousel__dot-fill {
    display: block;
    height: 100%;
    width: 100%;
    background: #ffffff;
    border-radius: inherit;
    transform: scaleX(0);
    transform-origin: left center;
  }

  .hero-carousel__dot.is-active:not(.is-progressing) .hero-carousel__dot-fill {
    transform: scaleX(1);
  }

  .hero-carousel__dot.is-progressing .hero-carousel__dot-fill {
    animation: hero-dot-progress var(--hero-progress-ms, 5000ms) linear forwards;
  }

  .hero-carousel__dot.is-paused .hero-carousel__dot-fill {
    animation-play-state: paused;
  }

  @keyframes hero-dot-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media screen and (min-width: 990px) {
    .hero-carousel {
      grid-template-columns: 1fr 1fr;
      column-gap: 0;
    }

    .hero-carousel__dots {
      grid-column: 2;
      align-self: end;
      transform: none;
      margin-bottom: 16px;
    }

    .hero-carousel__slide {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'content media';
      gap: 16px 0;
      min-height: 360px;
      background-color: var(--hero-slide-bg);
      border-radius: 12px;
      overflow: hidden;
    }

    .hero-carousel__media {
      aspect-ratio: auto;
      min-height: 360px;
      height: 100%;
      border-radius: 0;
    }

    .hero-carousel__content {
      max-width: none;
      padding-block: 1rem;
      padding-inline: 12px;
    }

    .hero-carousel__heading {
      font-size: 32px;
      padding-bottom: 12px;
    }

    .hero-carousel__description,
    .hero-carousel__content--center .hero-carousel__description,
    .hero-carousel__content--right .hero-carousel__description {
      margin: 0 0 1.5rem;
      text-align: left;
    }
  }

  @media screen and (min-width: 990px) {
    .hero-carousel {
      grid-template-columns: 1fr 2fr;
      column-gap: 0;
    }

    .hero-carousel__slide {
      grid-template-columns: 1fr 2fr;
      gap: 16px 0;
      min-height: 420px;
    }

    .hero-carousel__media {
      min-height: 420px;
    }

    .hero-carousel__content {
      padding-block: 1.5rem;
      padding-inline: 12px;
    }

    .hero-carousel__heading {
      font-size: 44px;
      padding-bottom: 16px;
    }

    .hero-carousel__description {
      margin: 0 0 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel__track {
      transition: none;
    }

    .hero-carousel__dot-fill {
      animation: none !important;
    }

    .hero-carousel__dot.is-active .hero-carousel__dot-fill {
      transform: scaleX(1);
    }
  }
</style>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<div class="section section--{{ section.settings.section_width }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}" style="{% render 'spacing-padding', settings: section.settings %}">
  <div
    class="hero-carousel"
    id="hero-carousel-{{ section.id }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
    style="--hero-progress-ms: {{ section.settings.autoplay_speed | times: 1000 }}ms; --hero-slide-bg: {{ section.settings.slide_background_color }};">
    <div class="hero-carousel__track">
      {% for block in section.blocks %}
        {% if block.type == 'slide' %}
          <div class="hero-carousel__slide" {{ block.shopify_attributes }}>
            <div class="hero-carousel__media">
              {% if block.settings.image %}
                <img
                  class="hero-carousel__image"
                  src="{{ block.settings.image | image_url: width: 1600 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 800 }} 800w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w,
                    {{ block.settings.image | image_url: width: 1600 }} 1600w
                  "
                  sizes="(min-width: 990px) 66vw, (min-width: 990px) 50vw, 100vw"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                  loading="{% if forloop.index == 1 %}eager{% else %}lazy{% endif %}">
              {% else %}
                <div class="hero-carousel__image hero-carousel__image--placeholder">
                  {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>

            <div class="hero-carousel__content hero-carousel__content--{{ block.settings.text_align }}">
              {% if block.settings.subheading != blank %}
                <p class="hero-carousel__subheading">{{ block.settings.subheading }}</p>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h2 class="hero-carousel__heading">{{ block.settings.heading }}</h2>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="hero-carousel__description">{{ block.settings.description }}</p>
              {% endif %}
              <div class="hero-carousel__buttons">
                {% if block.settings.button_label != blank %}
                  <a href="{{ block.settings.button_link | default: '#' }}" class="button button--primary">
                    {{- block.settings.button_label -}}
                  </a>
                {% endif %}
                {% if block.settings.button_label_2 != blank %}
                  <a href="{{ block.settings.button_link_2 | default: '#' }}" class="button button--secondary">
                    {{ block.settings.button_label_2 }}
                    <svg
                      viewBox="0 0 24 24"
                      width="16"
                      height="16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="hero-carousel__dots" role="tablist">
        {% for block in section.blocks %}
          <button
            type="button"
            class="hero-carousel__dot{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}">
            <span class="hero-carousel__dot-fill" aria-hidden="true"></span>
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.getElementById('hero-carousel-{{ section.id }}');
    if (!root) return;
  
    var track = root.querySelector('.hero-carousel__track');
    var slides = root.querySelectorAll('.hero-carousel__slide');
    var dots = root.querySelectorAll('.hero-carousel__dot');
    var total = slides.length;
    var current = 0;
    var autoplay = root.dataset.autoplay === 'true';
    var speed = parseInt(root.dataset.speed, 10) || 5000;
    var timer = null;
    var remaining = speed;
    var startedAt = 0;
    var paused = false;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
    if (!total) return;
  
    function resetProgress(dot) {
      dot.classList.remove('is-progressing', 'is-paused');
      var fill = dot.querySelector('.hero-carousel__dot-fill');
      if (!fill) return;
      fill.style.animation = 'none';
      void fill.offsetWidth;
      fill.style.animation = '';
    }
  
    function startProgress(dot) {
      if (!autoplay || reduceMotion || total < 2) return;
      resetProgress(dot);
      dot.classList.add('is-progressing');
    }
  
    function goTo(index) {
      current = (index + total) % total;
      track.style.transform = 'translateX(-' + current * 100 + '%)';
  
      dots.forEach(function (dot) {
        var isActive = parseInt(dot.dataset.index, 10) === current;
        resetProgress(dot);
        dot.classList.toggle('is-active', isActive);
        if (isActive) startProgress(dot);
      });
    }
  
    function clearTimer() {
      if (!timer) return;
      clearTimeout(timer);
      timer = null;
    }
  
    function scheduleNext() {
      if (!autoplay || total < 2 || paused || timer) return;
      startedAt = Date.now();
      timer = setTimeout(function () {
        timer = null;
        remaining = speed;
        goTo(current + 1);
        scheduleNext();
      }, remaining);
    }
  
    function startAutoplay() {
      if (!autoplay || total < 2) return;
      paused = false;
      remaining = speed;
      clearTimer();
      var activeDot = root.querySelector('.hero-carousel__dot.is-active');
      if (activeDot) startProgress(activeDot);
      scheduleNext();
    }
  
    function pauseAutoplay() {
      if (!autoplay || total < 2 || paused) return;
      paused = true;
      if (timer) {
        remaining = Math.max(50, remaining - (Date.now() - startedAt));
        clearTimer();
      }
      dots.forEach(function (dot) {
        if (dot.classList.contains('is-progressing')) {
          dot.classList.add('is-paused');
        }
      });
    }
  
    function resumeAutoplay() {
      if (!autoplay || total < 2 || !paused) return;
      paused = false;
      dots.forEach(function (dot) {
        dot.classList.remove('is-paused');
      });
      scheduleNext();
    }
  
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        goTo(parseInt(dot.dataset.index, 10));
        startAutoplay();
      });
    });
  
    root.addEventListener('mouseenter', pauseAutoplay);
    root.addEventListener('mouseleave', resumeAutoplay);
  
    goTo(0);
    startAutoplay();
  });
</script>

{% schema %}
  {
    "name": "Hero carousel",
    "tag": "section",
    "class": "shopify-section--hero-carousel",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "t:settings.background_color",
        "placeholder": "t:settings.default"
      },
      {
        "type": "color",
        "id": "slide_background_color",
        "label": "t:settings.slide_background_color",
        "placeholder": "t:settings.default",
        "default": "{{ settings.color_palette.background }}"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "t:settings.width",
        "options": [
          {
            "value": "page-width",
            "label": "t:options.page"
          }, {
            "value": "full-width",
            "label": "t:options.full"
          }
        ],
        "default": "page-width"
      },
      {
        "type": "header",
        "content": "t:content.padding"
      },
      {
        "type": "range",
        "id": "padding-block-start",
        "label": "t:settings.top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }, {
        "type": "range",
        "id": "padding-block-end",
        "label": "t:settings.bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }, {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay slides",
        "default": true
      }, {
        "type": "range",
        "id": "autoplay_speed",
        "label": "Autoplay speed (seconds)",
        "min": 3,
        "max": 10,
        "step": 1,
        "default": 5
      }
    ],
    "blocks": [
      {
        "type": "slide",
        "name": "Slide",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "RIFTBOUND: ORIGINS"
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "Subheading",
            "default": "Pre-order now"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "The Runeterra you know, now in your hands. Build your legend with Champions like Ahri, Yasuo and Jinx in Riot Games' first-ever TCG."
          }, {
            "type": "select",
            "id": "text_align",
            "label": "Content position",
            "options": [
              {
                "value": "left",
                "label": "Left"
              }, {
                "value": "center",
                "label": "Center"
              }, {
                "value": "right",
                "label": "Right"
              }
            ],
            "default": "center"
          }, {
            "type": "text",
            "id": "button_label",
            "label": "First button label",
            "default": "Shop now"
          }, {
            "type": "url",
            "id": "button_link",
            "label": "First button link"
          }, {
            "type": "text",
            "id": "button_label_2",
            "label": "Second button label",
            "default": "View release event"
          }, {
            "type": "url",
            "id": "button_link_2",
            "label": "Second button link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Hero carousel",
        "blocks": [
          {
            "type": "slide"
          }, {
            "type": "slide"
          }, {
            "type": "slide"
          }
        ]
      }
    ]
  }
{% endschema %}