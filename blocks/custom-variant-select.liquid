{% comment %}
  BLOCK: Variant selects (Condition + Location)
  ------------------------------------------------------------
  Uses `closest.product` so this works when nested inside ANY
  product card group in the customizer — no hardcoded variable
  name dependency.

  - "Condition" dropdown pulls from a real product OPTION
    (matched by name, set below) and updates the hidden variant
    id input on this same card when changed, so the card's
    native "Add" button adds the correct variant.
  - "Location" dropdown is tag-based (product tags formatted
    "Location: Melbourne"), informational only — does not
    affect variant/price, matching your existing store-location
    logic.
{% endcomment %}


{% render 'text-block-styles' %}

<style>
  .variant-selects {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .variant-selects__select {
    width: 100%;
    height: 48px;
    padding: 0.5rem 0.9rem;
    border: 1px solid #C0DFF6;
    border-radius: 8px;
    font-size: 15px;
    color: #1D1A17;
    background: #fff;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 7.4L0 1.4L1.4 0L6 4.6L10.6 0L12 1.4L6 7.4Z' fill='%235C554C'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 12px 8px;
    padding-right: 34px;
    cursor: pointer;
  }

  .variant-selects__select:focus-visible {
    outline: none;
    border-color: #8FB8DC;
  }
</style>

<div class="variant-selects" {{ block.shopify_attributes }}>
  {% assign product = closest.product %}
  {% assign variant = product.selected_or_first_available_variant %}

  {% comment %} --- Condition (or any option name you set below) --- {% endcomment %}
  {% assign target_option = product.options_with_values | where: 'name', block.settings.option_name | first %}

  {% if target_option %}
    {% assign option_index = target_option.position | minus: 1 %}
    <select class="variant-selects__select" data-option-name="{{ target_option.name | escape }}" data-option-position="{{ target_option.position }}" data-variant-select>
      {% for value in target_option.values %}
        {% case value %}
          {% when 'NM' %} {% assign display_value = 'Near Mint' %}
          {% when 'LP' %} {% assign display_value = 'Lightly Played' %}
          {% when 'MP' %} {% assign display_value = 'Moderately Played' %}
          {% when 'HP' %} {% assign display_value = 'Heavily Played' %}
          {% when 'DMG' %} {% assign display_value = 'Damaged' %}
          {% when 'FS' %} {% assign display_value = 'Factory Sealed' %}
          {% else %} {% assign display_value = value %}
        {% endcase %}
        <option value="{{ value | escape }}" {% if variant.options[option_index] == value %}selected{% endif %}>
          {{ display_value }}
        </option>
      {% endfor %}
    </select>
  {% endif %}

  {% comment %} --- Location (tag-based, informational) --- {% endcomment %}
  {% assign all_locations = block.settings.locations | split: ',' %}

  {% if all_locations.size > 0 %}
    {% assign product_location_names = '' %}
    {% for tag in product.tags %}
      {% assign tag_prefix = tag | slice: 0, 9 %}
      {% if tag_prefix == 'Location:' %}
        {% assign location_name = tag | remove_first: 'Location:' | strip %}
        {% assign product_location_names = product_location_names | append: location_name | append: '||' %}
      {% endif %}
    {% endfor %}
    {% assign product_locations = product_location_names | split: '||' %}

    <select class="variant-selects__select" data-store-select>
      {% for location in all_locations %}
        {% assign location = location | strip %}
        {% assign is_available = false %}
        {% for product_location in product_locations %}
          {% if product_location == location %}
            {% assign is_available = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        <option value="{{ location | escape }}" {% if is_available %}selected{% else %}disabled{% endif %}>
          {{ location }}{% unless is_available %} (Unavailable){% endunless %}
        </option>
      {% endfor %}
    </select>
  {% endif %}

  {% comment %} Embed variants for client-side matching, scoped to THIS block instance {% endcomment %}
  <script type="application/json" data-variants-json-{{ block.id }}>
    [
      {% for v in product.variants %}
        {
          "id": {{ v.id | json }},
          "options": {{ v.options | json }},
          "available": {{ v.available | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</div>

<script>
(function () {
  var container = document.currentScript.previousElementSibling;
  if (!container) return;

  var blockId = '{{ block.id }}';
  var variantsScript = document.querySelector('[data-variants-json-' + blockId + ']');
  var variants = variantsScript ? JSON.parse(variantsScript.textContent) : [];
  var select = container.querySelector('[data-variant-select]');

  if (!select || !variants.length) return;

  function findVariant(value) {
    var position = parseInt(select.dataset.optionPosition, 10) - 1;
    return variants.find(function (v) {
      return v.options[position] === value;
    });
  }

  select.addEventListener('change', function () {
    var match = findVariant(select.value);
    if (!match) return;

    var card = container.closest('product-card, [data-product-id]');
    if (!card) return;

    var hiddenInput = card.querySelector('input[name="id"]');
    if (hiddenInput) {
      hiddenInput.value = match.id;
    }
  });
})();
</script>

{% schema %}
{
  "name": "Variant selects",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "option_name",
      "label": "Product option to show as dropdown",
      "default": "Condition",
      "info": "Must match the exact option name on your products, e.g. \"Condition\""
    },
    {
      "type": "textarea",
      "id": "locations",
      "label": "Store locations (comma-separated)",
      "default": "Melbourne, Sydney, Frankston",
      "info": "Product tags must be formatted exactly as \"Location: Melbourne\" to match"
    }
  ],
  "presets": [
    {
      "name": "Variant selects",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
