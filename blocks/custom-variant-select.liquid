{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
  assign selected_variant = product_resource.selected_or_first_available_variant
%}

{% stylesheet %}
  .card-variant-selects {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-top: 4px;
  }

  .card-variant-selects__select {
    width: 100%;
    height: 48px;
    padding: 0.5rem 30px 0.5rem 0.6rem;
    border: 1px solid #c0dff6;
    border-radius: 8px;
    font-size: 15px;
    color: #1d1a17;
    background-color: #fff;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 7.4L0 1.4L1.4 0L6 4.6L10.6 0L12 1.4L6 7.4Z' fill='%235C554C'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 12px 8px;
    appearance: none;
    cursor: pointer;
  }

  .card-variant-selects__select:focus-visible {
    outline: none;
    border-color: #8fb8dc;
  }
{% endstylesheet %}

{% unless product_resource == blank %}
  <div
    class="card-variant-selects trending__selects"
    data-card-variant-selects
    {{ block.shopify_attributes }}
  >
    {% for option in product_resource.options_with_values %}
      <select
        class="card-variant-selects__select trending__select"
        aria-label="{{ option.name | escape }}"
        data-option-name="{{ option.name | escape }}"
        data-option-position="{{ forloop.index }}"
        data-variant-option
      >
        {% for value in option.values %}
          {% liquid
            case value
              when 'MI'
                assign display_value = 'Minor Imperfections'
              when 'FS'
                assign display_value = 'Factory Sealed'
              when 'NM'
                assign display_value = 'Near Mint'
              when 'LP'
                assign display_value = 'Lightly Played'
              when 'MP'
                assign display_value = 'Moderately Played'
              when 'HP'
                assign display_value = 'Heavily Played'
              when 'DMG'
                assign display_value = 'Damaged'
              when 'FS'
                assign display_value = 'Factory Sealed'
              else
                assign display_value = value
            endcase
          %}
          <option
            value="{{ value | escape }}"
            {% if selected_variant.options[forloop.parentloop.index0] == value %}
              selected
            {% endif %}
          >
            {{ display_value }}
          </option>
        {% endfor %}
      </select>
    {% endfor %}

    {% comment %}
      Store locations dropdown — product tags must be formatted as "Location: Melbourne".
      Re-enable with a comma-separated `locations` setting on this block.

      {% liquid
        assign show_locations = false
        if block.settings.locations != blank
          assign all_locations = block.settings.locations | split: ','
          assign show_locations = true
        endif
      %}

      {% if show_locations %}
        {% liquid
          assign product_location_names = ''
          for tag in product_resource.tags
            assign tag_prefix = tag | slice: 0, 9
            if tag_prefix == 'Location:'
              assign location_name = tag | remove_first: 'Location:' | strip
              assign product_location_names = product_location_names | append: location_name | append: '||'
            endif
          endfor
          assign product_locations = product_location_names | split: '||'
        %}

        <select class="card-variant-selects__select trending__select" data-store-select aria-label="{{ 'content.store' | t }}">
          {% for location in all_locations %}
            {% assign location_name = location | strip %}
            {% if location_name != blank %}
              {% liquid
                assign is_available = false
                for product_location in product_locations
                  if product_location == location_name
                    assign is_available = true
                    break
                  endif
                endfor
              %}
              <option
                value="{{ location_name | escape }}"
                {% if is_available %}
                  selected
                {% else %}
                  disabled
                {% endif %}
              >
                {{ location_name }}
                {%- unless is_available %} ({{ 'products.product.unavailable' | t }}){% endunless %}
              </option>
            {% endif %}
          {% endfor %}
        </select>
      {% endif %}
    {% endcomment %}

    <script type="application/json" data-variants-json>
      [
        {%- for variant_item in product_resource.variants -%}
          {
            "id": {{ variant_item.id | json }},
            "options": {{ variant_item.options | json }},
            "available": {{ variant_item.available | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  </div>
{% endunless %}

{% javascript %}
  if (!window.__cardVariantSelectsBound) {
    window.__cardVariantSelectsBound = true;

    document.addEventListener('change', function (event) {
      var select = event.target;
      if (!select || !select.hasAttribute || !select.hasAttribute('data-variant-option')) return;

      var container = select.closest('[data-card-variant-selects]');
      if (!container) return;

      var variantsScript = container.querySelector('[data-variants-json]');
      var variants = [];
      if (variantsScript) {
        try {
          variants = JSON.parse(variantsScript.textContent);
        } catch (error) {
          return;
        }
      }

      var optionSelects = container.querySelectorAll('[data-variant-option]');
      if (!variants.length || !optionSelects.length) return;

      var chosenOptions = [];
      optionSelects.forEach(function (optionSelect) {
        var position = parseInt(optionSelect.dataset.optionPosition, 10) - 1;
        chosenOptions[position] = optionSelect.value;
      });

      var match = variants.find(function (variant) {
        return chosenOptions.every(function (value, index) {
          return variant.options[index] === value;
        });
      });
      if (!match) return;

      var card = container.closest('product-card, [data-product-id]');
      if (!card) return;

      var hiddenInput = card.querySelector('input[name="id"]');
      if (hiddenInput) hiddenInput.value = match.id;
    });
  }
{% endjavascript %}

{% comment %}
  Store locations setting — JSON schema cannot be commented, so this is parked here.
  {
    "type": "textarea",
    "id": "locations",
    "label": "t:settings.store_locations",
    "info": "t:info.store_locations"
  }
{% endcomment %}

{% schema %}
{
  "name": "t:names.card_variant_selects",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "t:names.card_variant_selects",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}