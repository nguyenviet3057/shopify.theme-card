                  "text_8J4xYA": {
                    "type": "text",
                    "name": "t:names.text",
                    "settings": {
                      "text": "<p>The Games Cube is dedicated to providing you the very best experience. It doesn't matter if you order cards online or you are in-store to play a tournament or just pick up some cards or paints. We strive to be the very best Magic: The Gathering store in Australia, while also providing the very best customer service on all other card games (Dragon Ball Super, Flesh and Blood, Pokemon, One Piece), board games, role playing games, miniatures and painting.</p>",
                      "width": "100%",
                      "max_width": "none",
                      "alignment": "left",
                      "type_preset": "rte",
                      "font": "var(--font-body--family)",
                      "font_size": "",
                      "line_height": "normal",
                      "letter_spacing": "normal",
                      "case": "none",
                      "wrap": "pretty",
