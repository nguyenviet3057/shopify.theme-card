                      "padding-inline-end": 0
                    },
                    "blocks": {}
                  },
                  "text_jXFRPH": {
                    "type": "text",
                    "name": "t:names.text",
                    "settings": {
                      "text": "<ul><li><strong>To do this we believe in having expert staff in all games so you get the right person every time.</strong></li><li><strong>Super fast same day shipping.</strong></li><li><strong>Cleanliness and appearance is a key part of the store. We have the highest standards. The store is filled with abundant natural light, air-conditioned, clean and easy to find.</strong></li></ul>",
                      "width": "100%",
                      "max_width": "none",
                      "alignment": "left",
