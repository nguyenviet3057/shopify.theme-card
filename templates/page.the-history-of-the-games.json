                "settings": {
                  "text": "<p><strong>From two people to a team</strong></p>",
                  "width": "fit-content",
                  "max_width": "normal",
                  "alignment": "left",
                  "type_preset": "h4",
                  "font": "var(--font-body--family)",
                  "font_size": "1rem",
                  "line_height": "normal",
                  "letter_spacing": "normal",
                  "case": "none",
                  "wrap": "pretty",
