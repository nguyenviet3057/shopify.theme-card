                "settings": {
                  "text": "<p><strong>Built by Magic players</strong></p>",
                  "width": "fit-content",
                  "max_width": "normal",
                  "alignment": "left",
                  "type_preset": "h4",
                  "font": "var(--font-body--family)",
                  "font_size": "1rem",
                  "line_height": "normal",
