                "settings": {
                  "text": "<p><strong>More than 13 years of Magic</strong></p>",
                  "width": "fit-content",
                  "max_width": "normal",
                  "alignment": "left",
                  "type_preset": "h4",
                  "font": "var(--font-body--family)",
                  "font_size": "1rem",
