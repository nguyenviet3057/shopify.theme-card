                "custom_liquid_Y9QXdP": {
                  "type": "custom-liquid",
                  "name": "t:names.custom_liquid",
                  "settings": {
                    "full_width": true,
                    "custom_liquid": "<style>\n.trending__selects{\npadding-top: 4px;\n}\n  .trending__select {\n    width: 100%;\n    padding: 0.5rem 0.6rem;\n    border: 1px solid #C0DFF6;\n    border-radius: 4px;\n    font-size: 15px;\n    margin-bottom: 4px;\n    background: #fff;\n    height: 48px;\n    appearance: none;\n    -webkit-appearance: none;\n    -moz-appearance: none;\n    background-image: url(\"data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 7.4L0 1.4L1.4 0L6 4.6L10.6 0L12 1.4L6 7.4Z' fill='%235C554C'/%3E%3C/svg%3E\");\n    background-repeat: no-repeat;\n    background-position: right 12px center;\n    background-size: 12px 8px;\n    padding-right: 30px;\n  }\n</style>\n\n<div class=\"trending__selects\" {{ block.shopify_attributes }} >\n  {% assign product = closest.product %} \n  {% assign variant = product.selected_or_first_available_variant %} \n\n  {% for option in product.options_with_values %} \n    <select\n      class=\"trending__select\"\n      data-option-name=\"{{ option.name | escape }} \"\n      data-option-position=\"{{ forloop.index }} \"\n      data-variant-option\n    >\n      {% for value in option.values %} \n        {% case value %} \n          {% when 'NM' %}\n             {% assign display_value = 'Near Mint' %} \n          {% when 'LP' %}\n             {% assign display_value = 'Lightly Played' %} \n          {% when 'MP' %}\n             {% assign display_value = 'Moderately Played' %} \n          {% when 'HP' %}\n             {% assign display_value = 'Heavily Played' %} \n          {% when 'DMG' %}\n             {% assign display_value = 'Damaged' %} \n          {% else %}\n             {% assign display_value = value %} \n        {% endcase %} \n        <option\n          value=\"{{ value | escape }} \"\n          {% if variant.options[forloop.parentloop.index0] == value %} \n            selected\n          {% endif %} \n        >\n          {{ display_value }} \n        </option>\n      {% endfor %} \n    </select>\n  {% endfor %} \n\n  {% comment %} \n    ==========================================\n    HARD-CODED STORE LOCATIONS\n    Product tag format: Location: Melbourne\n    ==========================================\n  {% endcomment %} \n\n  {% comment %} \n  {% assign all_locations = 'Melbourne||My Custom Location||Shop location' | split: '||' %} \n  {% assign product_location_names = '' %} \n\n  {% for tag in product.tags %} \n    {% assign tag_prefix = tag | slice: 0, 9 %} \n    {% if tag_prefix == 'Location:' %} \n      {% assign location_name = tag | remove_first: 'Location:' | strip %} \n      {% assign product_location_names = product_location_names | append: location_name | append: '||' %} \n    {% endif %} \n  {% endfor %} \n\n  {% assign product_locations = product_location_names | split: '||' %} \n\n  <select class=\"trending__select\" data-store-select>\n    {% for location in all_locations %} \n      {% assign is_available = false %} \n      {% for product_location in product_locations %} \n        {% assign clean_product_location = product_location | strip %} \n        {% if clean_product_location == location %} \n          {% assign is_available = true %} \n          {% break %} \n        {% endif %} \n      {% endfor %} \n      <option value=\"{{ location | escape }} \" {% if is_available %} selected{% else %}disabled{% endif %} >\n        {{ location }}{% unless is_available %}(Unavailable){% endunless %} \n      </option>\n    {% endfor %} \n  </select>\n  {% endcomment %} \n  \n  {% comment %} Variants for client-side matching, scoped to this block instance {% endcomment %} \n  <script type=\"application/json\" data-variants-json-{{ block.id }} >\n    [\n      {% for v in product.variants %} \n        {\n          \"id\": {{ v.id | json }} ,\n          \"options\": {{ v.options | json }} ,\n          \"available\": {{ v.available | json }} \n        }{% unless forloop.last %},{% endunless %} \n      {% endfor %} \n    ]\n  </script>\n</div>\n\n<script>\n(function () {\n  var container = document.currentScript.previousElementSibling;\n  if (!container) return;\n\n  var blockId = '{{ block.id }} ';\n  var variantsScript = document.querySelector('[data-variants-json-' + blockId + ']');\n  var variants = variantsScript ? JSON.parse(variantsScript.textContent) : [];\n  var optionSelects = container.querySelectorAll('[data-variant-option]');\n\n  if (!variants.length || !optionSelects.length) return;\n\n  function findMatchingVariant() {\n    var chosenOptions = [];\n    optionSelects.forEach(function (select) {\n      var position = parseInt(select.dataset.optionPosition, 10) - 1;\n      chosenOptions[position] = select.value;\n    });\n    return variants.find(function (v) {\n      return chosenOptions.every(function (val, i) {\n        return v.options[i] === val;\n      });\n    });\n  }\n\n  function updateHiddenVariantInput(variant) {\n    if (!variant) return;\n    var card = container.closest('product-card, [data-product-id]');\n    if (!card) return;\n    var hiddenInput = card.querySelector('input[name=\"id\"]');\n    if (hiddenInput) hiddenInput.value = variant.id;\n  }\n\n  optionSelects.forEach(function (select) {\n    select.addEventListener('change', function () {\n      updateHiddenVariantInput(findMatchingVariant());\n    });\n  });\n})();\n</script>"
