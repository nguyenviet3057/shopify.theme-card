ion":"row","vertical_on_mobile":false,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":8,"width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","custom_height":100,"background_media":"none","background_color":"","video_position":"cover","background_image_position":"cover","toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","border":"none","border_width":1,"border_opacity":100,"border_color":"","border_radius":0,"link":"","open_in_new_tab":false,"placeholder":"","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"price_zbnC9z":{"type":"price","name":"t:names.product_price","settings":{"show_sale_price_first":true,"show_installments":false,"show_tax_info":false,"type_preset":"custom","width":"fit-content","alignment":"left","font":"var(--font-body--family)","font_size":"2rem","line_height":"normal","letter_spacing":"normal","case":"none","text_color":"#207fc4","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"custom_liquid_hfa8bG":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"full_width":false,"custom_liquid":"{% assign variant = closest.product.selected_or_first_available_variant %} \n\n<div class=\"product-inventory\">\n  {% if closest.product == blank %} \n    <span style=\"color:red;\">DEBUG: closest.product also blank<\/span>\n  {% elsif variant.inventory_management != 'shopify' %}\n    <span style=\"color:red;\">DEBUG: inventory_management = \" {{ variant.inventory_management }} \"<\/span>\n  {% else %}\n    {% if variant.inventory_quantity > 0 and variant.inventory_quantity <= 10 %} \n      <span class=\"product-inventory__badge product-inventory__badge--low\">{{ variant.inventory_quantity }} left<\/span>\n    {% elsif variant.inventory_quantity > 10 %}\n      <span class=\"product-inventory__badge product-inventory__badge--ok\"> {{ variant.inventory_quantity }} left<\/span>\n    {% else %}\n      {% if variant.inventory_policy == 'continue' %} \n        <span class=\"product-inventory__badge product-inventory__badge--backorder\">Backorder<\/span>\n      {% else %}\n        <span class=\"product-inventory__badge product-inventory__badge--out\">Out of stock<\/span>\n      {% endif %} \n    {% endif %} \n  {% endif %} \n<\/div>\n\n<style>\n  .product-inventory__badge { display:inline-block; font-size:10px; font-weight:700; padding:0.3rem 0.7rem; border-radius:4px; }\n  .product-inventory__badge--low { background:#FCE6D6; color:#C25A1E; }\n  .product-inventory__badge--ok { background:#E3F3E9; color:#2E7D4F; }\n  .product-inventory__badge--out { background:#FBE4E4; color:#B0231C; }\n  .product-inventory__badge--backorder { background:#EAF2FB; color:#2F6FED; }\n<\/style>"},"blocks":{}}},"block_order":["price_zbnC9z","custom_liquid_hfa8bG"]},"custom_liquid_yY8Dyg":{"type":"custom-liquid","name":"t:names.custom_liquid","disabled":true,"settings":{"full_width":false,"custom_liquid":"<style>\n.trending__selects {\n  padding-top: 4px;\n}\n\n.trending__option-group {\n  margin-bottom: 12px;\n}\n\n.trending__option-label {\n  display: block;\n  font-size: 15px;\n  font-weight: 400;\n  color: #1D1A17;\n  margin-bottom: 6px;\n}\n\n.trending__pill-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.trending__pill {\n  padding: 0.5rem 0.9rem;\n  border: 1px solid #C0DFF6;\n  border-radius: 8px;\n  background: #fff;\n  font-size: 14px;\n  font-weight: 400;\n  color: #1D1A17;\n  cursor: pointer;\n  transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;\n}\n\n.trending__pill.is-selected {\n  border-color: #C0DFF6;\n  color: #207FC4;\n  background: transparent;\n}\n\n.trending__pill:disabled {\n  cursor: not-allowed;\n}\n<\/style>\n\n<div class=\"trending__selects\" {{ block.shopify_attributes }} >\n  {% assign product = closest.product %} \n  {% assign variant = product.selected_or_first_available_variant %} \n\n  {% for option in product.options_with_values %} \n    <div class=\"trending__option-group\" data-option-name=\"{{ option.name | escape }} \" data-option-position=\"{{ forloop.index }} \" data-variant-option-group>\n      <span class=\"trending__option-label\">{{ option.name }} <\/span>\n      <div class=\"trending__pill-row\">\n        {% for value in option.values %} \n          {% case value %} \n   {% when 'MI' %}\n {% assign display_value = 'Minor Imperfections' %}\n  {% when 'FS' %}\n  {% assign display_value = 'Factory Sealed' %}\n       {% when 'NM' %}\n               {% assign display_value = 'Near Mint' %} \n            {% when 'LP' %}\n               {% assign display_value = 'Lightly Played' %} \n            {% when 'MP' %}\n               {% assign display_value = 'Moderately Played' %} \n            {% when 'HP' %}\n               {% assign display_value = 'Heavily Played' %} \n            {% when 'DMG' %}\n               {% assign display_value = 'Damaged' %} \n            {% else %}\n               {% assign display_value = value %} \n          {% endcase %} \n          <button\n            type=\"button\"\n            class=\"trending__pill{% if variant.options[forloop.parentloop.index0] == value %} is-selected{% endif %} \"\n            data-pill-value=\"{{ value | escape }} \"\n          >\n            {{ display_value }} \n          <\/button>\n        {% endfor %} \n      <\/div>\n    <\/div>\n  {% endfor %} \n\n  {% comment %} \n    ==========================================\n    HARD-CODED STORE LOCATIONS\n    Product tag format: Location: Melbourne\n    ==========================================\n  {% endcomment %} \n\n  {% assign all_locations = 'Melbourne||My Custom Location||Shop location' | split: '||' %} \n  {% assign product_location_names = '' %} \n\n  {% for tag in product.tags %} \n    {% assign tag_prefix = tag | slice: 0, 9 %} \n    {% if tag_prefix == 'Location:' %} \n      {% assign location_name = tag | remove_first: 'Location:' | strip %} \n      {% assign product_location_names = product_location_names | append: location_name | append: '||' %} \n    {% endif %} \n  {% endfor %} \n\n  {% assign product_locations = product_location_names | split: '||' %} \n\n  <div class=\"trending__option-group\" data-store-group>\n    <span class=\"trending__option-label\">Store<\/span>\n    <div class=\"trending__pill-row\">\n      {% for location in all_locations %} \n        {% assign is_available = false %} \n        {% for product_location in product_locations %} \n          {% assign clean_product_location = product_location | strip %} \n          {% if clean_product_location == location %} \n            {% assign is_available = true %} \n            {% break %} \n          {% endif %} \n        {% endfor %} \n        <button\n          type=\"button\"\n          class=\"trending__pill{% if forloop.first %} is-selected{% endif %} \"\n          data-store-pill\n          data-store-value=\"{{ location | escape }} \"\n          {% unless is_available %} disabled{% endunless %} \n        >\n          {{ location }}{% unless is_available %}(Unavailable){% endunless %} \n        <\/button>\n      {% endfor %} \n    <\/div>\n  <\/div>\n\n  {% comment %} Variants for client-side matching, scoped to this block instance {% endcomment %} \n  <script type=\"application\/json\" data-variants-json-{{ block.id }} >\n    [\n      {% for v in product.variants %} \n        {\n          \"id\": {{ v.id | json }} ,\n          \"options\": {{ v.options | json }} ,\n          \"available\": {{ v.available | json }} \n        }{% unless forloop.last %},{% endunless %} \n      {% endfor %} \n    ]\n  <\/script>\n<\/div>\n\n<script>\n(function () {\n  var container = document.currentScript.previousElementSibling;\n  if (!container) return;\n\n  var blockId = '{{ block.id }} ';\n  var variantsScript = document.querySelector('[data-variants-json-' + blockId + ']');\n  var variants = variantsScript ? JSON.parse(variantsScript.textContent) : [];\n  var optionGroups = container.querySelectorAll('[data-variant-option-group]');\n\n  if (!variants.length || !optionGroups.length) return;\n\n  function findMatchingVariant() {\n    var chosenOptions = [];\n    optionGroups.forEach(function (group) {\n      var position = parseInt(group.dataset.optionPosition, 10) - 1;\n      var selectedPill = group.querySelector('.trending__pill.is-selected');\n      chosenOptions[position] = selectedPill ? selectedPill.dataset.pillValue : null;\n    });\n    return variants.find(function (v) {\n      return chosenOptions.every(function (val, i) {\n        return v.options[i] === val;\n      });\n    });\n  }\n\n  function updateHiddenVariantInput(variant) {\n    if (!variant) return;\n    var card = container.closest('product-card, [data-product-id]');\n    if (!card) return;\n    var hiddenInput = card.querySelector('input[name=\"id\"]');\n    if (hiddenInput) hiddenInput.value = variant.id;\n  }\n\n  optionGroups.forEach(function (group) {\n    var pills = group.querySelectorAll('.trending__pill');\n    pills.forEach(function (pill) {\n      pill.addEventListener('click', function () {\n        if (pill.disabled) return;\n        pills.forEach(function (p) { p.classList.remove('is-selected'); });\n        pill.classList.add('is-selected');\n        updateHiddenVariantInput(findMatchingVariant());\n      });\n    });\n  });\n\n  \/* Store pills are informational only — just toggle selected state, no variant impact *\/\n  var storePills = container.querySelectorAll('[data-store-pill]');\n  storePills.forEach(function (pill) {\n    pill.addEventListener('click', function () {\n      if (pill.disabled) return;\n      storePills.forEach(function (p) { p.classList.remove('is-selected'); });\n      pill.classList.add('is-selected');\n    });\n  });\n})();\n<\/script>"},"blocks":{}},"variant_picker_KLEfTD":{"type":"variant-picker","name":"t:names.product_variant_picker","settings":{"variant_style":"buttons","show_swatches":true,"option_label_text_color":"","variant_style_class":"custom","custom_variant_background":"{{ settings.color_palette.color3 }}","custom_variant_text":"{{ settings.color_palette.foreground }}","custom_variant_border":"#c0dff6","selected_variant_style_class":"custom","custom_selected_variant_background":"#ecf7ff","custom_selected_variant_text":"#207fc4","custom_selected_variant_border":"#c0dff6","alignment":"left","padding-block-start":0,"padding-block-end":8,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"group_Hatiai":{"type":"group","name":"t:names.group","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":12,"width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","custom_height":100,"background_media":"none","background_color":"","video_position":"cover","background_image_position":"cover","toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","border":"none","border_width":1,"border_opacity":100,"border_color":"","border_radius":0,"link":"","open_in_new_tab":false,"placeholder":"","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"text_EtTkBR":{"type":"text","name":"t:names.text","settings":{"text":"<p>Quantity<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"custom","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","text_color":"","background":false,"background_color":"#00000